{"doc_id": "136dfba9ee5931a6913c268344daa03160bfd2623b75fc76eb6da34181f4303c", "extractor_version": "0.3.0", "schema_version": "1.1.0", "field": "tax_basis", "status": "present", "value_ja": "落\n札決定に当たっては、入札書に記載された金\n額に当該金額の10パーセントに相当する額を\n加算した金額（当該金額に１円未満の端数があるときは、その端数金額を切り捨てるものとする。)をもって落札価格とするので、入札\n者は消費税及び地方消費税に係る課税事業者であるか免税事業者であるかを問わず、見積もった契約金額の110分の100に相当する金額を入札書に記載すること。", "normalized": {"basis": "bid_excludes_tax"}, "value_en": "Bidders must write an amount excluding tax (100/110 of the estimated contract price), as 10% will be added to determine the award price.", "citations": ["h_s40", "h_s41", "h_s42", "h_s43", "h_s44"], "provenance": {"pre_labelers": [{"provider": "gemini", "model": "gemini-3.8-flash", "date": "2026-10-11", "prompt_version": "sv4"}, {"provider": "local", "model": "Qwen3.5-9B-Q4_K_M", "date": "2026-10-11", "prompt_version": "sv4"}], "agreement": true, "auto_checks": [{"name": "schema_valid", "passed": true}, {"name": "citations_exist", "passed": true}, {"name": "field_applicable", "passed": true}, {"name": "value_in_citation", "passed": true}, {"name": "values_roundtrip", "passed": true}, {"name": "heading_cue", "passed": true}], "reviewed_by": "claude_code", "review_note": "accepted A; h_s40 to h_s44: the award price is the bid plus 10 percent and bidders write 110分の100 of their estimate, an amount without tax: bid_excludes_tax.", "final_state": "silver_model_reviewed", "prompt_version": "sv4", "labeler_overlap": true, "reviewed_choice": "gemini"}}
